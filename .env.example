# =============================================================
# 唯一配置来源：构建与本地开发都从这里读。
# 用法：cp .env.example .env（scripts/setup.sh 在 .env 缺失时会自动创建，
#      且不会覆盖你已有的 .env）。docker compose 也会自动加载本文件。
# =============================================================

# 运行环境：local / dev / prod
APP_ENV=local

# 应用名称（后端 OpenAPI 标题等处使用）
APP_NAME=城市地下管网巡检养护平台

# ---- 后端 ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# SQLite 数据文件位置：示例数据与运行期改动都持久化在这里，重启/换机不丢。
# 容器内由 docker-compose 固定为 /srv/app/data/app.sqlite3（命名卷挂载）。
# 留空使用后端默认值 backend/data/app.sqlite3；填 :memory: 退回纯内存（调试用）。
DATABASE_PATH=

# ---- 前端 ----
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# 前端打包后直连后端的地址，留空表示走 Vite 同源代理（本地开发推荐留空）
VITE_API_BASE=

# ---- 跨域 ----
# 留空时后端按 FRONTEND_PORT 自动放行 http://127.0.0.1:<端口> 与 http://localhost:<端口>；
# 有额外来源时用逗号或空格分隔，例如：
# CORS_ORIGINS=http://127.0.0.1:5173,https://dev.example.com
CORS_ORIGINS=

# ---- 本地 dev 时 Vite 代理目标（容器内由 docker-compose 自动改写为服务名，不用填）----
# 留空默认 http://127.0.0.1:<BACKEND_PORT>
VITE_PROXY_TARGET=
