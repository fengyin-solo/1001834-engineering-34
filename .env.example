# ===== 本文件是所有配置的模板与默认值来源 =====
# 本地开发：cp .env.example .env 后按需修改（不复制也能用默认值跑起来）。
# 后端、前端 dev server、前端构建、docker compose 统一只读这一处，改配置只动这个文件。

# 运行环境标识（local / staging / prod ...）
APP_ENV=local

# 后端监听地址与端口（容器内由 compose 固定为 0.0.0.0:8000，这里只管本地）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 允许跨域访问后端的前端来源，逗号分隔；留空则按 FRONTEND_PORT 自动生成
ALLOWED_ORIGINS=

# 前端 dev server 监听地址与端口
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# 前端请求后端的方式：
# - VITE_API_BASE 留空：走 vite 代理 /api -> VITE_PROXY_TARGET（推荐，无跨域问题）
# - VITE_API_BASE 填完整地址（如 http://127.0.0.1:8000）：浏览器直连后端，需跨域白名单
VITE_API_BASE=
# vite 代理目标；留空自动用 http://127.0.0.1:${BACKEND_PORT}
VITE_PROXY_TARGET=

VITE_APP_NAME=城市地下管网巡检养护平台

# 示例数据文件（相对仓库根目录）；重复初始化不会覆盖已有数据
DATA_FILE=backend/data/store.json
